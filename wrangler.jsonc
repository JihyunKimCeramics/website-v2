{
  "main": ".open-next/worker.js",
  "name": "jihyun-website",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],

  // --- Static assets produced by OpenNext ---
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // --- Custom domains ---
  "routes": [
    { "pattern": "jihyunkimceramic.com", "custom_domain": true },
    { "pattern": "www.jihyunkimceramic.com", "custom_domain": true }
  ],

  // --- D1 bindings (make sure `binding` matches your code: env.shop_items) ---
  "d1_databases": [
    {
      "binding": "shop_items",           // <-- referenced in code as getRequestContext().env.shop_items
      "database_name": "shop_items",     // <-- your D1 database name
      "database_id": "36f4d983-bf16-49ae-8c0d-d7db0c1e1a14" // <-- your D1 database ID
    }
  ]
}